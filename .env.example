# Copy to .env and edit. NEVER commit .env. All values are optional.

# ---- S3 form defaults ------------------------------------------------------
# Prefer an IAM role / default AWS credential chain: leave both key fields EMPTY.
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT_URL=
S3_PORT=
S3_ADDRESSING_STYLE=auto        # auto | virtual | path
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- Limits ---------------------------------------------------------------
MAX_DBC_SIZE_MB=10
MAX_DBC_FILES=50
MAX_MEASUREMENT_SIZE_MB=2048
MAX_FILES_PER_JOB=25
MAX_S3_KEYS_LISTED=5000

# ---- Storage / logging -----------------------------------------------------
TEMP_ROOT=                      # empty = system temp dir
DATA_DIR=                       # empty = ./data (job history only)
STALE_TEMP_HOURS=24
LOG_LEVEL=INFO

# ---- Java decoder adapter (see services/java_decoder_client.py) -------------
JAVA_API_ENABLED=false
JAVA_API_BASE_URL=
JAVA_API_ENDPOINT_PATH=
JAVA_API_AUTH_TYPE=none         # none | bearer | api_key | basic
JAVA_API_TOKEN=
JAVA_API_KEY_HEADER=X-API-Key
JAVA_API_USERNAME=
JAVA_API_PASSWORD=
JAVA_API_CONNECT_TIMEOUT=5
JAVA_API_READ_TIMEOUT=120
JAVA_API_VERIFY_TLS=true
