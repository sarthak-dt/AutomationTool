<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.stellar.platform</groupId>
    <artifactId>stellar-ai-platform</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>stellar-ai-platform</name>
    <description>Stellar AI Platform — multi-module automotive measurement analysis skeleton</description>

    <modules>
        <module>stellar-domain</module>
        <module>stellar-parser-spi</module>
        <module>stellar-parser-mf4</module>
        <module>stellar-parser-asc</module>
        <module>stellar-parser-blf</module>
        <module>stellar-parser-text</module>
        <module>stellar-dbc-core</module>
        <module>stellar-a2l-core</module>
        <module>stellar-odx-pdx-core</module>
        <module>stellar-processing-core</module>
        <module>stellar-analysis-core</module>
        <module>stellar-storage-core</module>
        <module>stellar-api</module>
        <module>stellar-desktop</module>
        <module>stellar-server</module>
        <module>stellar-testkit</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <junit.version>5.11.4</junit.version>
        <spring-boot.version>3.4.2</spring-boot.version>
        <springdoc.version>2.8.5</springdoc.version>
        <javafx.version>21.0.6</javafx.version>
        <sqlite-jdbc.version>3.53.2.1</sqlite-jdbc.version>
        <pdfbox.version>3.0.5</pdfbox.version>

        <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.5.2</maven-surefire-plugin.version>
        <surefire.excludedGroups>release-nft,live-e2e</surefire.excludedGroups>
        <maven-jar-plugin.version>3.4.2</maven-jar-plugin.version>
        <javafx-maven-plugin.version>0.0.8</javafx-maven-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Internal modules -->
            <dependency>
                <groupId>com.stellar.platform</groupId>
                <artifactId>stellar-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.stellar.platform</groupId>
                <artifactId>stellar-parser-spi</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.stellar.platform</groupId>
                <artifactId>stellar-parser-mf4</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.stellar.platform</groupId>
                <artifactId>stellar-parser-asc</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.stellar.platform</groupId>
                <artifactId>stellar-parser-blf</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.stellar.platform</groupId>
                <artifactId>stellar-parser-text</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.stellar.platform</groupId>
                <artifactId>stellar-dbc-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.stellar.platform</groupId>
                <artifactId>stellar-a2l-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.stellar.platform</groupId>
                <artifactId>stellar-odx-pdx-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.stellar.platform</groupId>
                <artifactId>stellar-processing-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.stellar.platform</groupId>
                <artifactId>stellar-analysis-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.stellar.platform</groupId>
                <artifactId>stellar-storage-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.stellar.platform</groupId>
                <artifactId>stellar-storage-core</artifactId>
                <version>${project.version}</version>
                <type>test-jar</type>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>com.stellar.platform</groupId>
                <artifactId>stellar-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.stellar.platform</groupId>
                <artifactId>stellar-testkit</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- External BOMs / versions -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <dependency>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-controls</artifactId>
                <version>${javafx.version}</version>
            </dependency>
            <dependency>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-fxml</artifactId>
                <version>${javafx.version}</version>
            </dependency>
            <dependency>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-web</artifactId>
                <version>${javafx.version}</version>
            </dependency>
            <dependency>
                <groupId>org.xerial</groupId>
                <artifactId>sqlite-jdbc</artifactId>
                <version>${sqlite-jdbc.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.pdfbox</groupId>
                <artifactId>pdfbox</artifactId>
                <version>${pdfbox.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                        <encoding>${project.build.sourceEncoding}</encoding>
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                    <configuration>
                        <useModulePath>false</useModulePath>
                        <!--
                          Surefire's manifest classpath jar is created under the user temp
                          directory. On this machine that is C: while the reactor is on D:.
                          JDK 21 then refuses those Class-Path entries ("other has different
                          root") and the fork dies with ClassNotFoundException for classes
                          that are present in target/test-classes. This flag is the JDK
                          check the Surefire dump itself names. It does not skip tests.
                        -->
                        <argLine>-Djdk.net.URLClassPath.disableClassPathURLCheck=true</argLine>
                        <excludedGroups>${surefire.excludedGroups}</excludedGroups>
                        <systemPropertyVariables>
                            <stellarai.test.isolate>true</stellarai.test.isolate>
                        </systemPropertyVariables>
                        <properties>
                            <configurationParameters>
                                junit.jupiter.extensions.autodetection.enabled=true
                            </configurationParameters>
                        </properties>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${maven-jar-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-maven-plugin</artifactId>
                    <version>${javafx-maven-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <!-- Large-file / soak NFT. Default mvn test / verify excludes @Tag("release-nft"). -->
    <profiles>
        <profile>
            <id>release-nft</id>
            <properties>
                <surefire.excludedGroups></surefire.excludedGroups>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <groups>release-nft</groups>
                            <excludedGroups></excludedGroups>
                            <failIfNoSpecifiedTests>false</failIfNoSpecifiedTests>
                            <argLine>-Xmx3g -XX:+UseG1GC -Djdk.net.URLClassPath.disableClassPathURLCheck=true</argLine>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
