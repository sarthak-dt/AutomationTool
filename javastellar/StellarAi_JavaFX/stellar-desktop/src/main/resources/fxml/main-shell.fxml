<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="root" styleClass="app-root"
            minWidth="0" minHeight="0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.stellar.platform.desktop.ui.MainShellController">

    <top>
        <HBox fx:id="topHeader" styleClass="top-header,modern-top-header" spacing="12" alignment="CENTER_LEFT">
            <HBox spacing="10" alignment="CENTER_LEFT" styleClass="brand-lockup">
                <StackPane fx:id="brandMarkHost" styleClass="brand-mark" minWidth="32" prefWidth="32" maxWidth="32"
                           minHeight="32" prefHeight="32" maxHeight="32"/>
                <VBox spacing="0" alignment="CENTER_LEFT">
                    <Label text="StellarAI" styleClass="brand-wordmark"/>
                    <Label text="AUTOMOTIVE PLATFORM" styleClass="brand-subtitle"/>
                </VBox>
            </HBox>
            <HBox fx:id="projectSelector" styleClass="project-selector" spacing="8" alignment="CENTER_LEFT"
                  onMouseClicked="#onProjectSelectorClicked"
                  minWidth="140" prefWidth="240" maxWidth="300"
                  minHeight="40" prefHeight="40" maxHeight="40" HBox.hgrow="SOMETIMES">
                <StackPane fx:id="projectSelectorIcon" styleClass="project-selector-icon" minWidth="16" prefWidth="16"
                           maxWidth="16" minHeight="16" prefHeight="16" maxHeight="16"/>
                <Label fx:id="projectNameLabel" text="No active project" styleClass="project-selector-value"
                       maxWidth="Infinity" minWidth="0" HBox.hgrow="ALWAYS"/>
                <Label text="⌄" styleClass="project-selector-chevron"/>
            </HBox>
            <StackPane fx:id="headerSearchHost" styleClass="header-search-host"
                       minWidth="0" prefWidth="220" maxWidth="360"
                       minHeight="40" prefHeight="40" maxHeight="40" HBox.hgrow="SOMETIMES">
                <TextField fx:id="globalSearchField" promptText="Search projects and signals"
                           styleClass="header-search-field"/>
                <StackPane fx:id="headerSearchIcon" styleClass="header-search-icon" mouseTransparent="true"
                           StackPane.alignment="CENTER_LEFT" minWidth="16" prefWidth="16" maxWidth="16"
                           minHeight="16" prefHeight="16" maxHeight="16"/>
            </StackPane>
            <Region fx:id="headerSpacer" minWidth="0" HBox.hgrow="ALWAYS"/>
            <HBox fx:id="headerActions" styleClass="header-actions" spacing="8" alignment="CENTER_RIGHT">
                <Button fx:id="saveProjectButton" text="Save"
                        onAction="#onSaveProject"
                        styleClass="secondary-button,header-save-button"
                        mnemonicParsing="false"
                        minWidth="72" prefWidth="80"
                        minHeight="32" prefHeight="32" maxHeight="32"
                        visible="false" managed="false"/>
                <Label fx:id="saveStatusLabel" text="" styleClass="save-status-label"/>
                <Button fx:id="retrySaveButton" text="Retry"
                        onAction="#onRetrySave"
                        styleClass="secondary-button,header-retry-save-button"
                        mnemonicParsing="false"
                        visible="false" managed="false"
                        minHeight="32" prefHeight="32" maxHeight="32"/>
                <Button fx:id="projectStatusButton" styleClass="workflow-status-button" mnemonicParsing="false"
                        onAction="#onProjectStatusClicked"
                        visible="false" managed="false"
                        minHeight="32" prefHeight="32" maxHeight="32">
                    <graphic>
                        <HBox spacing="8" alignment="CENTER_LEFT" styleClass="workflow-status-content">
                            <Label fx:id="projectStatusLabel" text="No active project" styleClass="workflow-status-progress"/>
                            <Label fx:id="projectStageLabel" text="" styleClass="workflow-status-stage"/>
                        </HBox>
                    </graphic>
                </Button>
                <Button fx:id="newProjectHeaderButton" text="+ New Project"
                        onAction="#onNewProject"
                        styleClass="primary-button,header-new-project-button"
                        mnemonicParsing="false"
                        visible="false" managed="false"
                        minHeight="32" prefHeight="32" maxHeight="32"/>
                <HBox fx:id="globalProcessingBox" spacing="8" alignment="CENTER_LEFT" styleClass="global-processing"
                      managed="false" visible="false">
                    <Label fx:id="globalProcessingLabel" text="" styleClass="muted"/>
                    <ProgressBar fx:id="globalProcessingBar" prefWidth="120" progress="0"/>
                </HBox>
                <Button fx:id="headerSettingsButton" onAction="#onNavConfiguration" mnemonicParsing="false"
                        styleClass="header-icon-button" minWidth="32" prefWidth="32" maxWidth="32"
                        minHeight="32" prefHeight="32" maxHeight="32">
                    <tooltip><Tooltip text="Configuration"/></tooltip>
                </Button>
                <Button fx:id="aboutButton" text="?" onAction="#onAbout"
                        styleClass="header-icon-button,header-icon-glyph"
                        mnemonicParsing="false"
                        minWidth="32" prefWidth="32" maxWidth="32" minHeight="32" prefHeight="32" maxHeight="32">
                    <tooltip><Tooltip text="About StellarAI"/></tooltip>
                </Button>
            </HBox>
        </HBox>
    </top>

    <left>
        <VBox fx:id="sidebar" styleClass="sidebar,modern-sidebar" spacing="4"
              minHeight="0" maxHeight="Infinity">
            <VBox fx:id="figmaNavBox" spacing="2" styleClass="sidebar-primary">
                <Button fx:id="navDashboard" text="Workspace" styleClass="sidebar-item" onAction="#onNavHome"
                        maxWidth="Infinity" mnemonicParsing="false"/>
                <Button fx:id="navProjectsHome" text="Projects" styleClass="sidebar-item" onAction="#onNavProjectsHome"
                        maxWidth="Infinity" mnemonicParsing="false"
                        visible="false" managed="false"/>
            </VBox>
            <VBox fx:id="projectNavBox" spacing="4">
                <Separator styleClass="sidebar-separator"/>
                <Label fx:id="setupSectionLabel" text="SETUP" styleClass="sidebar-section-label"/>
                <VBox fx:id="setupNavBox" spacing="4" styleClass="sidebar-primary">
                    <Button fx:id="navSources" text="Sources" styleClass="sidebar-item" onAction="#onNavSources"
                            maxWidth="Infinity" mnemonicParsing="false"/>
                    <Button fx:id="navDecode" text="Decode &amp; Process" styleClass="sidebar-item" onAction="#onNavDecode"
                            maxWidth="Infinity" mnemonicParsing="false"/>
                </VBox>
                <Label fx:id="analysisSectionLabel" text="ANALYSIS" styleClass="sidebar-section-label"/>
                <VBox fx:id="analysisNavBox" spacing="4" styleClass="sidebar-primary">
                    <Button fx:id="navSignals" text="Signals" styleClass="sidebar-item" onAction="#onNavSignals"
                            maxWidth="Infinity" mnemonicParsing="false"/>
                    <Button fx:id="navGraphs" text="Graphs &amp; Analysis" styleClass="sidebar-item" onAction="#onNavGraphs"
                            maxWidth="Infinity" mnemonicParsing="false"/>
                    <Button fx:id="navInvestigations" text="Investigations" styleClass="sidebar-item" onAction="#onNavInvestigations"
                            maxWidth="Infinity" mnemonicParsing="false"/>
                </VBox>
            </VBox>
            <Button fx:id="navConfiguration" text="Configuration" styleClass="sidebar-item"
                    onAction="#onNavConfiguration"
                    maxWidth="Infinity" mnemonicParsing="false"/>
            <Region fx:id="sidebarSpacer" VBox.vgrow="ALWAYS" minHeight="6"/>
            <VBox fx:id="sidebarHealthCard" styleClass="sidebar-health-card" spacing="6"
                  visible="false" managed="false">
                <Label text="Project Status" styleClass="sidebar-health-title"/>
                <Label fx:id="sidebarHealthValue" text="No active project" styleClass="sidebar-health-value"/>
                <Label text="Local workspace" styleClass="sidebar-health-caption"/>
            </VBox>
            <Button fx:id="navCollapse" text="Collapse" styleClass="sidebar-collapse" onAction="#onToggleSidebar"
                    maxWidth="Infinity" mnemonicParsing="false">
                <tooltip><Tooltip text="Collapse navigation"/></tooltip>
            </Button>
        </VBox>
    </left>

    <center>
        <VBox fx:id="mainWorkspace" styleClass="main-workspace" spacing="0" minWidth="0" minHeight="0">
            <StackPane fx:id="workspaceStack" minWidth="0" minHeight="0" maxHeight="Infinity" VBox.vgrow="ALWAYS">
                <StackPane fx:id="contentHost" styleClass="content-host" minWidth="0" minHeight="0"/>
            </StackPane>
        </VBox>
    </center>

    <bottom>
        <HBox fx:id="workspaceStatusBar" styleClass="app-status-bar" spacing="4" alignment="CENTER_LEFT"
              minHeight="28" prefHeight="28" maxHeight="28">
            <Label fx:id="statusWorkspaceLabel" text="Local Workspace" styleClass="app-status-item"/>
            <Label text="·" styleClass="app-status-sep"/>
            <Label fx:id="statusDatabaseLabel" text="0 saved projects" styleClass="app-status-item"/>
            <Label text="·" styleClass="app-status-sep"/>
            <Label fx:id="statusProjectLabel" text="No active project" styleClass="app-status-item,app-status-project"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="statusWorkflowLabel" text="No active project" styleClass="app-status-item"/>
        </HBox>
    </bottom>
</BorderPane>
