<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.stellar.platform</groupId>
        <artifactId>stellar-ai-platform</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>stellar-server</artifactId>
    <name>stellar-server</name>
    <description>Spring Boot server exposing REST APIs over processing-core and storage-core</description>

    <dependencies>
        <dependency>
            <groupId>com.stellar.platform</groupId>
            <artifactId>stellar-domain</artifactId>
        </dependency>
        <dependency>
            <groupId>com.stellar.platform</groupId>
            <artifactId>stellar-parser-spi</artifactId>
        </dependency>
        <dependency>
            <groupId>com.stellar.platform</groupId>
            <artifactId>stellar-processing-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.stellar.platform</groupId>
            <artifactId>stellar-dbc-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.stellar.platform</groupId>
            <artifactId>stellar-storage-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.stellar.platform</groupId>
            <artifactId>stellar-storage-core</artifactId>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.stellar.platform</groupId>
            <artifactId>stellar-api</artifactId>
        </dependency>
        <!-- Parser plugins on the application classpath for ServiceLoader discovery -->
        <dependency>
            <groupId>com.stellar.platform</groupId>
            <artifactId>stellar-parser-mf4</artifactId>
        </dependency>
        <dependency>
            <groupId>com.stellar.platform</groupId>
            <artifactId>stellar-parser-asc</artifactId>
        </dependency>
        <dependency>
            <groupId>com.stellar.platform</groupId>
            <artifactId>stellar-parser-blf</artifactId>
        </dependency>
        <dependency>
            <groupId>com.stellar.platform</groupId>
            <artifactId>stellar-parser-text</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.stellar.platform.server.StellarServerApplication</mainClass>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
